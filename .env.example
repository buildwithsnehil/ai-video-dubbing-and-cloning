# Voice synthesis engine: 'jugnu' (Local AI Voice Cloning), 'edge_tts' (Free Cloud Neural), or 'elevenlabs' (API)
ACTIVE_TTS_PROVIDER=jugnu
JUGNU_MODEL_VARIANT=base
JUGNU_TEMPERATURE=0.3
JUGNU_MAX_TOKENS=75

# Video lip-sync engine: 'wav2lip' (Local GAN) or 'ffmpeg' (Preview)
ACTIVE_VIDEO_PROVIDER=wav2lip
WAV2LIP_RESIZE_FACTOR=1
WAV2LIP_NOSMOOTH=false
WAV2LIP_PADS=0 10 0 0


# Cloud API Keys (optional)
HF_TOKEN=
ELEVENLABS_API_KEY=

# Storage Directories
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
TEMP_DIR=temp
TEMPLATE_DIR=templates

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/api.log
